---
import BaseLayout from '../layouts/BaseLayout.astro';

const hero = `${import.meta.env.BASE_URL}hero.jpg`;
const resume = `${import.meta.env.BASE_URL}Garvit-Khurana-Resume.pdf`;
---
<BaseLayout>
  <header class="hero">
    <div class="hero-media">
      <img src={hero} alt="" width="1920" height="1080" fetchpriority="high" />
    </div>
    <div class="hero-shade" aria-hidden="true"></div>

    <div class="hero-top">
      <span class="live"><i></i> NYC · Remote</span>
      <span class="mono">BlackRock AI Accelerator</span>
    </div>

    <div class="hero-body">
      <h1 class="brand">Garvit Khurana</h1>
      <p class="role">AI Product Lead &amp; Engineer</p>
      <p class="lede">
        Shipping LLM and RAG systems on live capital-markets workflows —
        model, infra, and finance-grade evals in one loop.
      </p>
      <nav class="ctas" aria-label="Primary">
        <a href={resume} target="_blank" rel="noopener">Resume</a>
        <a href="https://www.linkedin.com/in/garvitkhurana/" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://github.com/garvitkhurana" target="_blank" rel="noopener">GitHub</a>
        <a href="mailto:garvit.khurana@columbia.edu">Email</a>
      </nav>
    </div>
  </header>

  <main>
    <section id="about" class="reveal">
      <div class="wrap">
        <p class="kicker">Now</p>
        <h2 class="section-title">In the model layer of markets.</h2>
        <p class="about-copy">
          Bond ops used to retype terms out of 100+ page prospectuses by hand —
          slow, error-prone, and the bottleneck on getting a bond to market.
          <strong>I own the RAG workflow that turns those prospectuses into structured security records</strong>,
          cutting time-to-market ~40%, then extended the same loop into private credit
          where the docs are messier and naive extraction breaks.
        </p>
        <p class="about-copy secondary">
          Day to day: roadmap and delivery across model (RAG, prompting, extraction),
          infra (APIs, pipelines, Azure), and evals/tracing so bad fields fail loudly
          before they reach a client workflow.
        </p>

        <div class="loop" aria-label="How the work is structured">
          <div class="loop-item">
            <span class="loop-label">Model</span>
            <p>OpenAI / Claude · LangChain · RAG · ChromaDB · Structured outputs · Tool calling</p>
          </div>
          <div class="loop-item">
            <span class="loop-label">Infra</span>
            <p>Python · FastAPI · SQL · PySpark · Azure / AWS · Databricks · ETL</p>
          </div>
          <div class="loop-item">
            <span class="loop-label">Evals / Tracing</span>
            <p>OpenTelemetry · Azure Monitor · LangSmith · Golden-set field checks</p>
          </div>
        </div>
      </div>
    </section>

    <section id="builds" class="reveal">
      <div class="wrap">
        <p class="kicker">Builds</p>
        <h2 class="section-title">Outside the day job.</h2>
        <div class="builds">
          <article class="build">
            <div class="build-meta">
              <span class="mono">Building now</span>
              <h3>Altline</h3>
            </div>
            <div class="build-body">
              <p class="build-quote">The model reads. The engine verifies.</p>
              <p>
                LLM extracts terms from a credit agreement; a rules engine recomputes
                borrowing-notice and rate-set numbers instead of trusting what an
                administrative agent sends. Agentic back office for alternative assets.
              </p>
              <p class="build-tech mono">LLM extraction · Guardrails · FastAPI</p>
            </div>
          </article>

          <article class="build">
            <div class="build-meta">
              <span class="mono">Public</span>
              <h3>
                <a href="https://github.com/garvitkhurana/agent-relay" target="_blank" rel="noopener">agent-relay</a>
              </h3>
            </div>
            <div class="build-body">
              <p>
                Hands an in-progress coding task to the next available agent
                (Claude, Codex, Cursor) when one hits a rate limit — git worktrees
                carry the file state so you don’t restart the prompt from scratch.
              </p>
              <p class="build-tech mono">Git · CLI · Multi-agent</p>
            </div>
          </article>

          <article class="build">
            <div class="build-meta">
              <span class="mono">Public</span>
              <h3>
                <a href="https://github.com/garvitkhurana/mlx-voice-clone" target="_blank" rel="noopener">mlx-voice-clone</a>
              </h3>
            </div>
            <div class="build-body">
              <p>
                Local voice-clone TTS on Mac (Qwen3 / MLX) with a FastAPI UI —
                a personal project on on-device inference.
              </p>
              <p class="build-tech mono">MLX · Qwen3 · FastAPI</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="experience" class="reveal">
      <div class="wrap">
        <p class="kicker">Work</p>
        <h2 class="section-title">Where it’s shipped.</h2>
        <div class="jobs">
          <article class="job">
            <p class="job-dates mono">2024 — Now</p>
            <div>
              <h3>Product Lead / Engineer II, AI Accelerator · <span class="co">BlackRock</span></h3>
              <ul>
                <li>Owned 0→1 for an internal LLM/RAG workflow that turns long bond prospectuses into structured security records — less manual retyping, ~40% faster time-to-market for new public bonds.</li>
                <li>Extended into private credit: tightened model → infra → evals/tracing so field validation and traced extraction runs fail loudly before bad data hits a client workflow.</li>
                <li>Work with client and RM teams on adoption; partner with data science on SQL, telemetry, and Azure so prioritization tracks what breaks in use.</li>
              </ul>
            </div>
          </article>
          <article class="job">
            <p class="job-dates mono">2022 — 2024</p>
            <div>
              <h3>Private Markets Associate · <span class="co">BlackRock</span></h3>
              <ul>
                <li>Launched the Private Governance Platform after teams were catching data errors late and separately: −80% manual intervention, +20% reporting accuracy into Aladdin.</li>
                <li>Built NLP issuer-search so PMs weren’t hunting the same issuer across systems that didn’t talk to each other.</li>
              </ul>
            </div>
          </article>
          <article class="job">
            <p class="job-dates mono">Earlier</p>
            <div>
              <h3>Product · data · ML · <span class="co">APG · PadSquad · HPE</span></h3>
              <ul>
                <li>ESG + NLP on 13F filings at APG; growth product in AdTech; CNN assistive-tech at HPE.</li>
                <li>Columbia MSBA · VIT CSE · NUS Data Science · four ML research publications.</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="contact" class="reveal">
      <div class="wrap contact-block">
        <p class="kicker">Contact</p>
        <h2 class="section-title">If you’re building with AI.</h2>
        <p class="ask">
          Open to roles where the product is AI in a complex, high-stakes domain —
          NYC, California, US remote, London, Canada.
        </p>
        <div class="contact-row">
          <a href="mailto:garvit.khurana@columbia.edu">garvit.khurana@columbia.edu</a>
          <a href={resume} target="_blank" rel="noopener">Resume</a>
          <a href="https://www.linkedin.com/in/garvitkhurana/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/garvitkhurana" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap">
    <span>© <span id="y"></span> Garvit Khurana</span>
    <span class="mono">AI Product Lead &amp; Engineer</span>
  </footer>
</BaseLayout>
